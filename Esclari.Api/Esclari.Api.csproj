<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Esclari.Api</RootNamespace>
    <UserSecretsId>esclari-api</UserSecretsId>
    <WarningsAsErrors>$(WarningsAsErrors);CA1502;MSG0005</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="CodeMetricsConfig.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Instituicoes\Aparencia\logo-horizontal-email.png" LogicalName="logo-horizontal-email.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Esclari.Api.Dados.Chamados" />
    <Using Include="Esclari.Api.Dados.Conversas" />
    <Using Include="Esclari.Api.Dados.Artigos" />
    <Using Include="Esclari.Api.Dados.Documentos" />
    <Using Include="Esclari.Api.Dados.Trechos" />
    <Using Include="Esclari.Api.Dados.Usuarios" />
    <Using Include="Esclari.Api.Dados.Cadastros" />
    <Using Include="Esclari.Api.Dados.Operadores" />
    <Using Include="Esclari.Api.Dados.Emails" />
    <Using Include="Esclari.Api.Dados.Push" />
    <Using Include="Esclari.Api.Dados.Fluxos" />
    <Using Include="Esclari.Api.Dados.Moodle" />
    <Using Include="Esclari.Api.Dados.Mcp" />
    <Using Include="Esclari.Api.Dados.Avisos" />
  </ItemGroup>
</Project>
